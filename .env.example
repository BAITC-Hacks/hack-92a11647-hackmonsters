# Сервер автоматически читает .env. Не используйте префикс VITE_ для секретов.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Необязательно: только для отдельного использования LLMRouter, UI использует OpenAI.
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_OUTPUT_MODE=json_object
